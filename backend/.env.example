# OpsPilot 运行环境配置模板
# 用法：cp .env.example .env   然后修改里面的值
# .env 已在 .gitignore 中，不会提交；本模板可以提交

# ---------------- 大模型（LLM） ----------------
# 不配则内置 Mock 模型，全链路仍可跑通（工具调用、引用角标都有），适合离线演示
# OpenAI 协议兼容的厂商都行，例如：
#   DeepSeek  OPENAI_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
#   智谱      OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4-flash
#   通义      OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=deepseek-chat
# 排障场景要稳定复现，温度别调高
LLM_TEMPERATURE=0.2

# ---------------- Embedding ----------------
# ⚠️ DeepSeek 不提供 /embeddings 接口：LLM 用 DeepSeek 时，Embedding 必须走 local
#    local / bge = sentence-transformers 的 BGE-M3 语义向量（需安装依赖，首次下载约 1-2GB）
#    openai    = 调 OPENAI_BASE_URL 的 /embeddings（需该厂商支持，注意 DeepSeek 不支持）
#    两者都不可用时服务会直接报错退出，不再静默降级到非语义向量
EMBED_BACKEND=local
EMBED_MODEL=BAAI/bge-m3
# CrossEncoder 重排：装了 sentence-transformers 后改 1，语义排序更好但每次检索多一次推理
RAG_RERANK=0
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------------- 检索参数 ----------------
RAG_TOP_K=5            # 最终喂给模型的条数
RAG_CANDIDATE_K=20     # 向量路 / BM25 路各自的候选数
# 最低「IDF 加权查询覆盖率」门槛：低于该值判定与问题无关，宁可返回空也不硬塞上下文。
# 实测相关查询最低约 0.145、无关查询最高约 0.144，区分度偏窄，故取保守值。
# 想让拒答更激进可上调到 0.15~0.2，但会误伤正常提问。
RAG_MIN_COVER=0.12
CHUNK_TARGET_CHARS=700 # 切分时的段落累积字符上限
CHUNK_OVERLAP_CHARS=80 # 相邻 chunk 尾部重叠字符数

# ---------------- 存储与服务 ----------------
# OPSPILOT_DATA_DIR=./data   # 索引目录，留空则用 backend/data（已 gitignore）
MAX_UPLOAD_MB=50
HOST=127.0.0.1

# ---------------- MCP 活数据工具（v0.2，可选）----------------
# 不启用时 Agent 只保留知识库检索，行为与 v0.1 完全一致。
# 启用两步：① uv pip install langchain-mcp-adapters  ② 启动 mcp_servers/ 下两个服务
# auto = 装了依赖且能连通才启用；1 = 强制尝试；0 = 完全关闭
MCP_ENABLED=auto
MCP_MONITOR_URL=http://127.0.0.1:8101/mcp
MCP_LOG_URL=http://127.0.0.1:8102/mcp
# transport：本地服务用 streamable_http；多数云端托管端点用 sse
MCP_MONITOR_TRANSPORT=streamable_http
MCP_LOG_TRANSPORT=streamable_http
MCP_CONNECT_TIMEOUT_SEC=3      # 握手探测超时，用于启动时判定可用性
MCP_TIMEOUT_SEC=15             # 单次工具调用超时（超时返回错误文本，不会中断 SSE 流）
MCP_MAX_RETRIES=2
MCP_MAX_RESULT_CHARS=4000      # 单次工具返回结果截断长度
MCP_MAX_TOOL_DESC_CHARS=400    # 工具描述截断长度（防止挤占上下文）
PORT=8000
